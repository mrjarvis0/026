# T01 Smart Binance Intelligence v2 - Environment Configuration
# Copy this to .env and modify as needed

# ============================================================================
# BINANCE API CREDENTIALS (Required for real trading, optional for paper)
# ============================================================================
# Get your API keys from: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true  # Set to false for real trading

# ============================================================================
# PAPER TRADING SETTINGS
# ============================================================================
PAPER_START_BALANCE=1000.0  # Starting paper balance in USDT
PAPER_FEE_PCT=0.001  # 0.10% round-trip trading fee (Binance spot default)

# ============================================================================
# ACCURACY GATE SETTINGS (Real Trading Lock)
# ============================================================================
ACCURACY_UNLOCK_THRESHOLD=70.0  # Minimum accuracy % to unlock real trading
ACCURACY_MIN_TRADES=50  # Minimum number of trades to unlock real trading

# ============================================================================
# RISK MANAGEMENT SETTINGS
# ============================================================================
RISK_PER_TRADE_PAPER=0.02  # 2% risk per trade in paper mode
RISK_PER_TRADE_REAL=0.01   # 1% risk per trade in real mode
STOP_LOSS_PCT=0.02  # 2% fixed stop loss (fallback when ATR unavailable)
TAKE_PROFIT_PCT=0.04  # 4% fixed take profit (fallback when ATR unavailable)
MAX_CONCURRENT_POSITIONS=3  # Maximum number of open positions
DAILY_LOSS_LIMIT_PCT=0.03  # 3% daily loss limit (circuit breaker)

# ============================================================================
# ADAPTIVE (ATR) STOPS & TRAILING SETTINGS
# ============================================================================
USE_ATR_STOPS=true  # Enable ATR-based stops/targets
ATR_PERIOD=14  # ATR calculation period
ATR_STOP_MULT=1.5  # Stop distance = ATR * this multiplier
ATR_TP_MULT=3.0  # Target distance = ATR * this multiplier (2:1 reward:risk)
TRAIL_ENABLED=true  # Enable trailing stops
TRAIL_PCT=0.015  # 1.5% trailing stop distance

# ============================================================================
# REGIME & LOSS-REFLECTION SETTINGS (Roadmap #16)
# ============================================================================
ADX_TREND_MIN=20.0  # ADX at/above this = trending regime
REFLECT_MIN_TRADES=8  # Minimum trades before reflection acts
REFLECT_LOSS_RATE=0.4  # >40% recent losses triggers reflection

# ============================================================================
# WEBSOCKET SETTINGS (Phase 2)
# ============================================================================
WEBSOCKET_ENABLED=true  # Enable WebSocket for real-time data
WEBSOCKET_URL=wss://stream.binance.com:9443/ws  # Binance WebSocket URL
WEBSOCKET_RECONNECT_DELAY=1.0  # Initial reconnect delay (seconds)
WEBSOCKET_MAX_RECONNECT_DELAY=60.0  # Maximum reconnect delay (seconds)
WEBSOCKET_RECONNECT_BACKOFF=1.5  # Exponential backoff multiplier
WEBSOCKET_PING_INTERVAL=30.0  # Ping interval to keep connection alive (seconds)

# ============================================================================
# SERVER SETTINGS
# ============================================================================
HOST=127.0.0.1  # Host to bind to
PORT=8000  # Port to listen on
# Additional hostnames allowed (comma-separated), e.g., a LAN IP
# Leave empty to restrict to localhost only (secure default)
TRUSTED_HOSTS=

# ============================================================================
# DEFAULT SETTINGS
# ============================================================================
DEFAULT_SYMBOL=BTC/USDT  # Default symbol on first load
DEFAULT_TIMEFRAME=5m  # Default timeframe on first load

# ============================================================================
# BACKTESTING SETTINGS (Phase 1)
# ============================================================================
BACKTEST_DATA_DIR=data/historical  # Directory for historical data cache
BACKTEST_LIMIT=10000  # Maximum candles to load per backtest
BACKTEST_FEE_PCT=0.001  # Trading fee for backtesting
BACKTEST_SLIPPAGE_PCT=0.0005  # Slippage for backtesting (0.05%)

# ============================================================================
# SCANNER SETTINGS (Phase 2)
# ============================================================================
SCANNER_ENABLED=false  # Enable multi-symbol scanner
SCANNER_INTERVAL=60  # Seconds between scans
SCANNER_CONCURRENCY=10  # Maximum concurrent symbol scans
SCANNER_MAX_SYMBOLS=500  # Maximum symbols to scan
SCANNER_MIN_VOLUME=1000000  # Minimum 24h volume to consider

# ============================================================================
# MULTI-TIMEFRAME SETTINGS (Phase 2)
# ============================================================================
MTF_ENABLED=false  # Enable multi-timeframe analysis
MTF_TIMEFRAMES=1m,5m,15m,1h  # Timeframes to analyze (comma-separated)
MTF_WEIGHTS=0.4,0.3,0.2,0.1  # Weights for each timeframe
MTF_TREND_FILTER=true  # Higher TF must not oppose lower TF signal

# ============================================================================
# PATTERN DETECTION SETTINGS (Phase 3)
# ============================================================================
PATTERN_DETECTION_ENABLED=false  # Enable pattern detection
PATTERN_MIN_CONFIDENCE=0.5  # Minimum confidence to consider pattern
PATTERN_REQUIRE_CONFIRMATION=false  # Require confirmation candle
PATTERN_CONFIRMATION_CANDLES=1  # Number of confirmation candles needed

# ============================================================================
# STRATEGY SETTINGS (Phase 3)
# ============================================================================
STRATEGY_MODE=single  # single/multi/all
STRATEGY_DEFAULT=scalping  # Default strategy for single mode
STRATEGY_SELECTION_CRITERIA=performance  # performance/volatility/market_condition
STRATEGY_AUTO_SELECT=false  # Auto-select strategy based on criteria

# ============================================================================
# FUTURES TRADING SETTINGS (Phase 4)
# ============================================================================
FUTURES_ENABLED=false  # Enable futures trading
FUTURES_EXCHANGE=binance  # Exchange for futures
FUTURES_TESTNET=true  # Use futures testnet
FUTURES_DEFAULT_LEVERAGE=5  # Default leverage (1-125)
FUTURES_MAX_LEVERAGE=20  # Maximum allowed leverage
FUTURES_MARGIN_MODE=cross  # cross/isolated
FUTURES_RISK_PER_TRADE=0.005  # 0.5% risk per futures trade
FUTURES_MAX_DRAWDOWN=0.10  # 10% max drawdown for futures
FUTURES_LIQUIDATION_RISK_THRESHOLD=0.10  # 10% liquidation risk warning
FUTURES_MAX_POSITIONS=5  # Maximum futures positions
FUTURES_FUNDING_RATE_WARNING=0.05  # 5% funding rate warning

# ============================================================================
# MACHINE LEARNING SETTINGS (Optional)
# ============================================================================
ML_ENABLED=false  # Enable ML-based trading
ML_MODEL_PATH=models/trading_model.pkl  # Path to trained model
ML_USE_HYBRID=true  # Combine ML with rule-based signals
ML_HYBRID_WEIGHTS=0.7,0.3  # Rule weight, ML weight

# ============================================================================
# NOTIFICATION SETTINGS (Optional)
# ============================================================================
NOTIFICATIONS_ENABLED=false  # Enable notifications
TELEGRAM_BOT_TOKEN=  # Telegram bot token
TELEGRAM_CHAT_ID=  # Telegram chat ID
NOTIFICATION_ON_ENTRY=true  # Notify on trade entry
NOTIFICATION_ON_EXIT=true  # Notify on trade exit
NOTIFICATION_ON_ERROR=true  # Notify on errors

# ============================================================================
# LOGGING SETTINGS
# ============================================================================
LOG_LEVEL=INFO  # DEBUG/INFO/WARNING/ERROR/CRITICAL
LOG_DIR=logs  # Directory for log files
LOG_FILE=trading_bot.log  # Log file name

# ============================================================================
# PERFORMANCE SETTINGS
# ============================================================================
BOT_INTERVAL=12  # Seconds between analysis cycles
MAX_CANDLES=250  # Maximum candles to fetch per request
MIN_BARS=30  # Minimum bars before generating signal
