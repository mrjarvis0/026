# ===== Merged from CIE-OS .gitignore on 2026-09-06 =====
# ==============================================================================
# SECRETS  -  never commit these
# ==============================================================================
.env
.env.*
!.env.example
!*.env.example
!.env.production.example
*.pem
*.key
*.p12
*.keystore
secrets/
**/secrets/
credentials.json
service-account*.json

# ==============================================================================
# Python
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# ==============================================================================
# Tooling caches
# ==============================================================================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/

# ==============================================================================
# Runtime output  -  regenerated, may contain wallet data or API responses
# ==============================================================================
logs/
*.log
data/
!data/.gitkeep
# T01's backend/data/ is a SOURCE package (collector.py, database.py, __init__.py),
# NOT runtime output — the blanket data/ rule above was hiding real source, so a
# fresh clone of main could not import backend.data and T01 failed to boot. The
# runtime DB lives in T01/data/ (still ignored above), so track only the source .py.
!agents/T01_Smart_Binance_Intelligence/backend/data/
!agents/T01_Smart_Binance_Intelligence/backend/data/*.py
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.stakpak/

# ==============================================================================
# Claude Code  -  local settings contain machine-specific paths
# ==============================================================================
.claude/settings.local.json
.claude/worktrees/

# ==============================================================================
# Editors / OS
# ==============================================================================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Google App Engine generated folder
appengine-generated/


# ===== Secrets protection (added during CIE-OS migration) =====
.env
.env.*
!.env.example
**/.env
**/.env.local
**/API_KEYS.md

# ===== Python / tooling junk =====
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
# 026 live supervisor runtime state (log already covered by *.log)
live/state.json
live/state.json.tmp
live/state.json.corrupt-*
live/supervisor.lock
