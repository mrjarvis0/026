# ==============================================================================
# A002 News Intelligence Agent — environment variables
# Copy to repo-root .env (existing file) and fill in keys you have.
# All vars are OPTIONAL — the agent runs in degraded mode without keys.
# ==============================================================================

# --- Agent --------------------------------------------------------------------
A002_AGENT_ENVIRONMENT=development
A002_AGENT_DEBUG=true

# --- Ingestion ----------------------------------------------------------------
A002_INGESTION_POLL_INTERVAL_SECONDS=60
A002_INGESTION_MAX_ITEMS_PER_FETCH=100
A002_INGESTION_NEWS_HISTORY_DAYS=30

# --- News APIs ----------------------------------------------------------------
A002_NEWS_TIINGO_API_KEY=
A002_NEWS_ALPACA_API_KEY=
A002_NEWS_ALPACA_SECRET_KEY=
A002_NEWS_FINNHUB_API_KEY=
A002_NEWS_NEWSAPI_KEY=
A002_NEWS_FINANCIALJUICE_API_KEY=

# --- Social -------------------------------------------------------------------
A002_SOCIAL_REDDIT_CLIENT_ID=
A002_SOCIAL_REDDIT_CLIENT_SECRET=
A002_SOCIAL_REDDIT_USER_AGENT=cie-os-a002/0.1
A002_SOCIAL_SUBREDDITS=wallstreetbets,cryptocurrency,stocks
A002_SOCIAL_ENABLE_X_STREAM=false
# Phase 6
A002_SOCIAL_TELEGRAM_BOT_TOKEN=
A002_SOCIAL_TELEGRAM_CHAT_IDS=
A002_SOCIAL_X_BEARER_TOKEN=
A002_SOCIAL_X_SEARCH_QUERY=crypto OR bitcoin OR ethereum OR stock OR finance lang:en -is:retweet

# --- Market data --------------------------------------------------------------
A002_MARKET_ALPHA_VANTAGE_API_KEY=
A002_MARKET_ENABLE_CRYPTO=true
A002_MARKET_ENABLE_STOCKS=true
A002_MARKET_ENABLE_FOREX=false

# --- Narrative / detection ----------------------------------------------------
A002_NARRATIVE_WINDOW_HOURS=24
A002_NARRATIVE_MIN_MENTIONS=3

# --- Models -------------------------------------------------------------------
A002_MODEL_FAKE_DETECTOR_MODEL=bert-base-uncased
A002_MODEL_FAKE_DETECTOR_THRESHOLD=0.5
A002_MODEL_IMPACT_MODEL_TYPE=rules
A002_MODEL_MIN_CONFIDENCE=0.6
