# $trategy-master — required secret NAMES only (Constitution R-A.9).
# Copy this file to `.env` and fill values locally. NEVER commit `.env`.
# Crypto BACKTESTING needs NO keys (public Binance data). Keys are only for PAPER trading.

# --- Binance Spot Testnet (crypto paper trading) ---
# Create at: https://testnet.binance.vision/  (testnet keys ONLY — never mainnet keys here)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- Binance USD-M Futures Testnet ($009-scalper) ---
# Create at: https://testnet.binancefuture.com/  (testnet keys ONLY — never mainnet keys here)
BINANCE_FUTURES_TESTNET_API_KEY=
BINANCE_FUTURES_TESTNET_API_SECRET=

# --- OANDA fxTrade Practice (forex paper trading) ---
# Practice (demo) account only: https://www.oanda.com/  → v20 API token
OANDA_PRACTICE_TOKEN=
OANDA_PRACTICE_ACCOUNT_ID=

# --- Alpaca Paper Trading (stocks) ---
# Paper endpoint: https://paper-api.alpaca.markets  (paper keys ONLY)
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=

# --- optional data providers (only if you use them) ---
# ALPHAVANTAGE_API_KEY=
# POLYGON_API_KEY=

# --- research layer (scripts/research.py) ---
# Web SEARCH needs ONE of these (both have free tiers). Fetch/Wikipedia/YouTube need NO key.
# Tavily: https://tavily.com   |   Brave: https://brave.com/search/api
TAVILY_API_KEY=
# BRAVE_API_KEY=

# Automated dossier drafting (research.py --auto) via the Anthropic API:
ANTHROPIC_API_KEY=
# RESEARCH_MODEL=claude-sonnet-5     # override the default drafting model
