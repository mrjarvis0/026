# Binance API Credentials (only needed for REAL trading — leave blank for paper mode)
# NEVER commit your real keys. Copy this file to .env and fill in your values.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Use Binance testnet for real-trading dry runs (recommended before live)
BINANCE_TESTNET=true

# Paper trading virtual starting balance (USDT)
PAPER_START_BALANCE=1000

# Accuracy gate: real trading unlocks only above this %, over MIN_TRADES samples
ACCURACY_UNLOCK_THRESHOLD=70
ACCURACY_MIN_TRADES=50

# Risk settings
RISK_PER_TRADE_PAPER=0.02
RISK_PER_TRADE_REAL=0.01
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
MAX_CONCURRENT_POSITIONS=3
DAILY_LOSS_LIMIT_PCT=0.03

# Server
HOST=127.0.0.1
PORT=8000
