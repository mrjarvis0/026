# Binance API Credentials (only needed for REAL trading — leave blank for paper mode)
# NEVER commit your real keys. Copy this file to .env and fill in your values.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Use Binance testnet for real-trading dry runs (recommended before live)
BINANCE_TESTNET=true

# Paper trading virtual starting balance (USDT)
PAPER_START_BALANCE=1000

# Round-trip fee per fill, as a fraction (0.001 = 0.10 % = Binance spot taker default).
# Paper fills simulate it; real fills have it subtracted when recording PnL (see REAL_FEE_PCT).
PAPER_FEE_PCT=0.001
# Fee tier used when recording REAL-mode PnL. The exchange really charges both
# legs, so the DB subtracts the same round-trip fee — set this to YOUR actual
# tier (VIP level, BNB discount on/off) so paper and real metrics stay comparable.
REAL_FEE_PCT=0.001

# Accuracy gate: real trading unlocks only above this %, over MIN_TRADES samples
ACCURACY_UNLOCK_THRESHOLD=70
ACCURACY_MIN_TRADES=50

# Risk settings
RISK_PER_TRADE_PAPER=0.02
RISK_PER_TRADE_REAL=0.01
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
MAX_CONCURRENT_POSITIONS=3
DAILY_LOSS_LIMIT_PCT=0.03

# Adaptive (ATR) stops & trailing — stops/targets scale with volatility instead of flat %
USE_ATR_STOPS=true
ATR_PERIOD=14
ATR_STOP_MULT=1.5
ATR_TP_MULT=3.0
TRAIL_ENABLED=true
TRAIL_PCT=0.015

# Regime & loss-reflection — ADX labels trend vs chop; reflection corrects losing streaks
ADX_TREND_MIN=20
REFLECT_MIN_TRADES=8
REFLECT_LOSS_RATE=0.4

# Server
HOST=127.0.0.1
PORT=8000
# Extra hostnames allowed to reach the API (comma-separated), e.g. a LAN IP.
# Leave empty to restrict to localhost only (secure default).
TRUSTED_HOSTS=
