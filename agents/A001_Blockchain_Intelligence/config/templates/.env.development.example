# A01 Development Environment
APP_ENV=development

A01_AGENT_DEBUG=true
A01_AGENT_MAX_WORKERS=4

A01_RPC_TIMEOUT_SECONDS=30
A01_RPC_RETRY_COUNT=3
A01_RPC_RETRY_DELAY_SECONDS=1.5

A01_CHAIN_CONFIRMATIONS=12

A01_DB_URL=sqlite+aiosqlite:///./data/database/a01.db
A01_DB_ECHO=false

A01_MEMORY_SHORT_TERM_SIZE=50
A01_MEMORY_WORKING_WINDOW=20
A01_MEMORY_LONG_TERM_ENABLED=true
A01_MEMORY_VECTOR_ENABLED=true

A01_AI_PROVIDER=mock
A01_AI_MODEL_NAME=gpt-4.1-mini
A01_AI_TEMPERATURE=0.2
A01_AI_MAX_TOKENS=2048

A01_LOG_LEVEL=INFO
A01_LOG_JSON_LOGS=true
A01_LOG_ENABLE_OTEL=true

A01_CACHE_ENABLED=true
A01_CACHE_MAX_SIZE=1024
A01_CACHE_TTL_SECONDS=300

A01_SEC_SECRET_DIR=./secrets
A01_SEC_ENV_PREFIX=A01_SECRET_
A01_SEC_ENABLE_STRICT_SECRETS=false
